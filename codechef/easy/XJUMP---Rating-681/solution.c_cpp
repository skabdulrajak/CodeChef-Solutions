#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while (t--)
	{
	    int n,k,m;
	    cin>>n>>k>>m;
        int bag_cap=k*m;
	    int b=n%bag_cap;
	    if(b==0)
	    {
	        cout<<	n/bag_cap<<endl;
	        

	}
	else
	{
	    cout <<(n/bag_cap)+1<<endl;
	}

}
}
