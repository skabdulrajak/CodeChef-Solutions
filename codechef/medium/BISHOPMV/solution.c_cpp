#include <bits/stdc++.h>
using namespace std;
void solve ()
{
    int x,y,x1,y1;
    cin >>x >> y >> x1 >>y1;
    if ((x+y)%2 != (x1 + y1) %2)
    {
        cout<< -1 <<endl;
        return;
    }
    if (abs(x -x1 )== abs ( y-y1))
    {
        cout<< 1<<endl;
    }
    else
    {
        cout<<2<<endl;
    }
}
int main() {
	// your code goes here
 int t;
 cin>>t;
 while (t--)
 {
     solve ();
 }
}
